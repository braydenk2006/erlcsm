# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Ordinex

# Database
DATABASE_URL=postgresql://commandry:commandry@localhost:5432/commandry?schema=public
DATABASE_URL_TEST=postgresql://commandry:commandry@localhost:5432/commandry_test?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (Better Auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Encryption for tenant secrets (ER:LC keys, Discord tokens, etc.)
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Discord OAuth (optional in development)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Email provider (Resend). Leave blank to use the development console adapter.
RESEND_API_KEY=
EMAIL_FROM="Ordinex <noreply@localhost>"

# Object storage (S3-compatible). Optional in development.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=commandry

# Stripe (test mode in non-production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Feature flags
FEATURE_FLAGS_PROVIDER=local

# AI provider (disabled by default)
AI_PROVIDER=none
AI_API_KEY=
AI_DEFAULT_MODEL=

# ER:LC
ERLC_MODE=simulator

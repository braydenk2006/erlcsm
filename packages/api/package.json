{
  "name": "@commandry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@commandry/audit": "workspace:*",
    "@commandry/automation": "workspace:*",
    "@commandry/command-center": "workspace:*",
    "@commandry/database": "workspace:*",
    "@commandry/entitlements": "workspace:*",
    "@commandry/integrations": "workspace:*",
    "@commandry/operations": "workspace:*",
    "@commandry/permissions": "workspace:*",
    "@commandry/roblox": "workspace:*",
    "@commandry/shared": "workspace:*",
    "@commandry/validation": "workspace:*",
    "@commandry/website": "workspace:*",
    "@commandry/workflow": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}

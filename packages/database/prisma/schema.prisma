  currentBreakStartedAt DateTime? @map("current_break_started_at")
  correctedByUserId     String?   @map("corrected_by_user_id")
  correctionNote        String?   @map("correction_note")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId, status])
  @@index([organizationId, status])
  @@map("shifts")
}

model OperationalSession {
  id               String    @id @default(cuid())

// =============================================================================
// Operational Time Platform
// Single append-only ledger of participation events. Shifts, sessions,
// attendance, activity, metrics, history, and analytics all derive from this —
// no feature stores its own time/activity totals.
// =============================================================================

model ParticipationEvent {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  organizationId  String   @map("organization_id")
  membershipId    String   @map("membership_id")
  userId          String   @map("user_id")
  type            String
  category        String
  occurredAt      DateTime @map("occurred_at")
  durationMinutes Int?     @map("duration_minutes")
  sourceType      String?  @map("source_type")
  sourceId        String?  @map("source_id")
  metadata        Json     @default("{}")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId, occurredAt])
  @@index([organizationId, type])
  @@map("participation_events")
}

model Shift {
  id                    String    @id @default(cuid())
  publicId              String    @unique @map("public_id")

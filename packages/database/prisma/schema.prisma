  discordEventLocation  String?  @map("discord_event_location")
  announcementTemplate  String?  @map("announcement_template")
  mentionRoleIds        String[] @default([]) @map("mention_role_ids")
  hostsMayPublish       Boolean  @default(true) @map("hosts_may_publish")
  approvalBeforePublish Boolean  @default(false) @map("approval_before_publish")
  updateOnChange        Boolean  @default(true) @map("update_on_change")
  cancelDeletesEvent    Boolean  @default(true) @map("cancel_deletes_event")
  reminderOffsets       Int[]    @default([1440, 60, 15]) @map("reminder_offsets")
  allowPublishWithoutHost Boolean @default(false) @map("allow_publish_without_host")
  startWindowMinutes    Int      @default(30) @map("start_window_minutes")
  // Verified private-server logged-minute policy
  graceBeforeMinutes    Int      @default(15) @map("grace_before_minutes")
  graceAfterMinutes     Int      @default(15) @map("grace_after_minutes")
  reconnectionToleranceSeconds Int @default(0) @map("reconnection_tolerance_seconds")
  minPresenceSeconds    Int      @default(60) @map("min_presence_seconds")
  roundingPolicy        String   @default("EXACT") @map("rounding_policy")
  maxCountableMinutes   Int      @default(100000) @map("max_countable_minutes")
  windowMode            String   @default("SCHEDULED_START") @map("window_mode")
  requireHostConfirmation Boolean @default(false) @map("require_host_confirmation")
  blockCompletionOnDiscrepancy Boolean @default(false) @map("block_completion_on_discrepancy")
  eligibleTeams         String[] @default([]) @map("eligible_teams")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("shift_scheduling_settings")
}

// Raw verified private-server presence intervals. Logged minutes are summed from
// these in exact seconds — never from scheduled duration or attendance status.
model PresenceInterval {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  scheduledShiftId     String    @map("scheduled_shift_id")
  membershipId         String    @map("membership_id")
  userId               String    @map("user_id")
  robloxUserId         String    @map("roblox_user_id")
  erlcServer           String?   @map("erlc_server")
  firstSeenAt          DateTime  @map("first_seen_at")
  lastSeenAt           DateTime  @map("last_seen_at")
  joinAt               DateTime? @map("join_at")
  leaveAt              DateTime? @map("leave_at")
  intervalStart        DateTime  @map("interval_start")
  intervalEnd          DateTime? @map("interval_end")
  durationSeconds      Int       @default(0) @map("duration_seconds")
  team                 String?
  callsign             String?
  permissionLevel      String?   @map("permission_level")
  source               String    @default("prc_snapshot")
  confidence           String    @default("CONFIRMED")
  reconciliationStatus String    @default("OPEN") @map("reconciliation_status")
  open                 Boolean   @default(true)
  eligible             Boolean   @default(true)
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([scheduledShiftId, membershipId])
  @@index([scheduledShiftId, robloxUserId, open])
  @@map("presence_intervals")
}

// Finalized verified minutes per member per shift (automatic + adjustment = final).
model ShiftLoggedMinutes {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  scheduledShiftId     String    @map("scheduled_shift_id")
  membershipId         String    @map("membership_id")
  userId               String    @map("user_id")
  automaticMinutes     Int       @default(0) @map("automatic_minutes")
  adjustmentMinutes    Int       @default(0) @map("adjustment_minutes")
  finalMinutes         Int       @default(0) @map("final_minutes")
  rawSeconds           Int       @default(0) @map("raw_seconds")
  eligibleSeconds      Int       @default(0) @map("eligible_seconds")
  confidence           String    @default("CONFIRMED")
  reconciliationStatus String    @default("CONFIRMED") @map("reconciliation_status")
  finalizedAt          DateTime? @map("finalized_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scheduledShiftId, membershipId])
  @@index([organizationId, membershipId])
  @@map("shift_logged_minutes")
}

model CorrectionRequest {
  id                String    @id @default(cuid())
  publicId          String    @unique @map("public_id")
  organizationId    String    @map("organization_id")
  scheduledShiftId  String    @map("scheduled_shift_id")
  membershipId      String    @map("membership_id")
  userId            String    @map("user_id")
  calculatedMinutes Int       @map("calculated_minutes")
  requestedMinutes  Int       @map("requested_minutes")
  explanation       String
  attachmentUrl     String?   @map("attachment_url")
  status            String    @default("SUBMITTED")
  reviewerUserId    String?   @map("reviewer_user_id")
  decisionNote      String?   @map("decision_note")
  appliedMinutes    Int?      @map("applied_minutes")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@map("correction_requests")
}

// =============================================================================
// Workflow Platform — one reusable engine for forms, applications, training,
// approvals, reviews, and any future submission/approval process. No feature
// stores its own form/approval/submission logic.
// =============================================================================

model WorkflowTemplate {
  id              String   @id @default(cuid())
  publicId        String   @unique @map("public_id")
  organizationId  String   @map("organization_id")
  key             String
  name            String
  category        String   @default("general")
  description     String?
  form            Json     @default("{}")
  workflow        Json     @default("{}")
  isBuiltIn       Boolean  @default(false) @map("is_built_in")
  active          Boolean  @default(true)
  submitRoleKeys  String[] @default([]) @map("submit_role_keys")
  reviewRoleKeys  String[] @default([]) @map("review_role_keys")
  version         Int      @default(1)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  WorkflowSubmission[]

  @@unique([organizationId, key])
  @@index([organizationId, category])
  @@map("workflow_templates")
}

model WorkflowSubmission {
  id                    String    @id @default(cuid())
  publicId              String    @unique @map("public_id")
  organizationId        String    @map("organization_id")
  templateId            String    @map("template_id")
  submitterMembershipId String    @map("submitter_membership_id")
  submitterUserId       String    @map("submitter_user_id")
  status                String    @default("DRAFT")
  currentStageId        String?   @map("current_stage_id")
  data                  Json      @default("{}")
  version               Int       @default(0)
  submittedAt           DateTime? @map("submitted_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     WorkflowTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  events       WorkflowEvent[]
  comments     WorkflowComment[]
  assignments  WorkflowAssignment[]
  attachments  WorkflowAttachment[]

  @@index([organizationId, templateId, status])
  @@index([organizationId, submitterMembershipId])
  @@map("workflow_submissions")
}

// Append-only submission timeline + automation-hook event stream.
model WorkflowEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  submissionId   String   @map("submission_id")
  type           String
  actorUserId    String?  @map("actor_user_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([organizationId, type])
  @@map("workflow_events")
}

model WorkflowComment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  submissionId   String   @map("submission_id")
  authorUserId   String   @map("author_user_id")
  body           String
  visibility     String   @default("APPLICANT")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("workflow_comments")
}

model WorkflowAssignment {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  submissionId        String    @map("submission_id")
  stageId             String    @map("stage_id")
  assigneeMembershipId String   @map("assignee_membership_id")
  assigneeUserId      String    @map("assignee_user_id")
  decision            String?
  decisionNote        String?   @map("decision_note")
  decidedAt           DateTime? @map("decided_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, stageId])
  @@index([assigneeMembershipId, decision])
  @@map("workflow_assignments")
}

// Attachment metadata. Files are served through a permission-checked endpoint by
// id — never a predictable public URL. Storage backend is pluggable.
model WorkflowAttachment {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  organizationId String   @map("organization_id")
  submissionId   String   @map("submission_id")
  uploaderUserId String   @map("uploader_user_id")
  filename       String
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submission   WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("workflow_attachments")
}

// =============================================================================
// Background jobs bookkeeping (BullMQ is source of truth; this aids ops)
// =============================================================================

model JobFailure {
  id        String   @id @default(cuid())
  queue     String
  jobName   String   @map("job_name")
  jobId     String?  @map("job_id")
  payload   Json     @default("{}")
  error     String
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([queue, createdAt])
  @@map("job_failures")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Identity (Better Auth compatible + Commandry extensions)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  publicId      String    @unique @map("public_id")
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sessions              Session[]
  accounts              Account[]
  memberships           Membership[]
  sentInvitations       Invitation[]           @relation("InvitationInviter")
  auditEvents           AuditEvent[]           @relation("AuditActor")
  activeOrganizationId  String?                @map("active_organization_id")
  platformRole          PlatformRole           @default(NONE) @map("platform_role")
  mfaEnabled            Boolean                @default(false) @map("mfa_enabled")
  robloxLink            RobloxIdentity?
  discordLink           DiscordIdentity?
  supportAccessSessions SupportAccessSession[] @relation("SupportActor")
  notifications         Notification[]
  announcements         Announcement[]
  robloxVerification    RobloxVerification?

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

enum PlatformRole {
  NONE
  SUPPORT
  ADMIN
  SUPERADMIN
}

// =============================================================================
// External identities
// =============================================================================

model RobloxIdentity {
  id              String    @id @default(cuid())
  publicId        String    @unique @map("public_id")
  userId          String    @unique @map("user_id")
  robloxUserId    String    @unique @map("roblox_user_id")
  username        String
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  verifiedAt      DateTime  @map("verified_at")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roblox_identities")
}

// Pending Roblox verification challenge (profile-description method). One in-flight
// challenge per Ordinex user; replaced on restart, deleted on success.
model RobloxVerification {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  robloxUserId String   @map("roblox_user_id")
  username     String
  displayName  String?  @map("display_name")
  code         String
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roblox_verifications")
}

model DiscordIdentity {
  id             String    @id @default(cuid())
  publicId       String    @unique @map("public_id")
  userId         String    @unique @map("user_id")
  discordUserId  String    @unique @map("discord_user_id")
  username       String
  globalName     String?   @map("global_name")
  avatarUrl      String?   @map("avatar_url")
  verifiedAt     DateTime  @map("verified_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_identities")
}

// =============================================================================
// Multi-tenant organizations
// =============================================================================

model Organization {
  id                 String             @id @default(cuid())
  publicId           String             @unique @map("public_id")
  name               String
  slug               String             @unique
  timezone           String             @default("UTC")
  organizationType   OrganizationType   @default(CUSTOM) @map("organization_type")
  approximateSize    ApproximateSize    @default(SMALL) @map("approximate_size")
  accentColor        String             @default("#0F766E") @map("accent_color")
  logoUrl            String?            @map("logo_url")
  terminology        Json               @default("{}")
  enabledModules     String[]           @default(["home", "live_server", "people", "staff", "departments", "moderation", "sessions", "activity", "cad", "integrations", "settings"]) @map("enabled_modules")
  onboardingStep     Int                @default(0) @map("onboarding_step")
  onboardingComplete Boolean            @default(false) @map("onboarding_complete")
  planKey            String             @default("free") @map("plan_key")
  status             OrganizationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  memberships           Membership[]
  invitations           Invitation[]
  roles                 Role[]
  ranks                 Rank[]
  departments           Department[]
  auditEvents           AuditEvent[]
  integrations          IntegrationCredential[]
  customDomains         OrganizationDomain[]
  supportAccessSessions SupportAccessSession[]
  notificationPrefs     NotificationPreference[]
  erlcPlayerSessions    ErlcPlayerSession[]
  cadCalls              CadCall[]
  cadUnits              CadUnit[]
  cadCivilians          CadCivilian[]
  cadVehicles           CadVehicle[]
  cadWarrants           CadWarrant[]
  cadRecords            CadRecord[]
  cadBolos              CadBolo[]
  cadAgencies           CadAgency[]
  cadSettings           CadSettings?
  cadStatusEvents       CadStatusEvent[]
  cadPenalCharges       CadPenalCharge[]
  subscription          Subscription?
  usageCounters         UsageCounter[]
  notifications         Notification[]
  announcements         Announcement[]
  participationEvents   ParticipationEvent[]
  shifts                Shift[]
  operationalSessions   OperationalSession[]
  attendanceRecords     AttendanceRecord[]
  operationsSettings    OperationsSettings?
  scheduledShifts       ScheduledShift[]
  shiftClaims           ShiftClaim[]
  scheduledShiftEvents  ScheduledShiftEvent[]
  prcPresenceMatches    PrcPresenceMatch[]
  shiftRecurrences      ShiftRecurrence[]
  shiftSchedulingSettings ShiftSchedulingSettings?
  presenceIntervals     PresenceInterval[]
  shiftLoggedMinutes    ShiftLoggedMinutes[]
  correctionRequests    CorrectionRequest[]
  workflowTemplates     WorkflowTemplate[]
  workflowSubmissions   WorkflowSubmission[]
  workflowEvents        WorkflowEvent[]
  workflowComments      WorkflowComment[]
  workflowAssignments   WorkflowAssignment[]
  workflowAttachments   WorkflowAttachment[]

  @@index([status])
  @@map("organizations")
}

enum OrganizationType {
  PRIVATE_SERVER
  ROLEPLAY
  DEPARTMENT_HEAVY
  LAW_ENFORCEMENT
  BORDER_ROLEPLAY
  CUSTOM
}

enum ApproximateSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  READ_ONLY
  PENDING_DELETION
  DELETED
}

model OrganizationDomain {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  domain         String    @unique
  isPrimary      Boolean   @default(false) @map("is_primary")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_domains")
}

model Membership {
  id             String           @id @default(cuid())
  publicId       String           @unique @map("public_id")
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  status         MembershipStatus @default(ACTIVE)
  title          String?
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles              MembershipRole[]
  rankId             String?             @map("rank_id")
  rank               Rank?               @relation(fields: [rankId], references: [id], onDelete: SetNull)
  departmentMembers  DepartmentMember[]
  permissionGrants   PermissionGrant[]
  permissionDenies   PermissionDenial[]
  breakGlassSessions BreakGlassSession[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("memberships")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  FORMER
}

model Invitation {
  id             String           @id @default(cuid())
  publicId       String           @unique @map("public_id")
  organizationId String           @map("organization_id")
  email          String
  roleKey        String           @default("member") @map("role_key")
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  message        String?
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  revokedAt      DateTime?        @map("revoked_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// =============================================================================
// Roles, ranks, departments, permissions
// =============================================================================

model Role {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  permissions    String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MembershipRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model MembershipRole {
  id           String   @id @default(cuid())
  membershipId String   @map("membership_id")
  roleId       String   @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

model Rank {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  organizationId String   @map("organization_id")
  name           String
  order          Int
  isStaff        Boolean  @default(true) @map("is_staff")
  discordRoleId  String?  @map("discord_role_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      Membership[]

  @@unique([organizationId, name])
  @@unique([organizationId, order])
  @@index([organizationId])
  @@map("ranks")
}

model Department {
  id             String    @id @default(cuid())
  publicId       String    @unique @map("public_id")
  organizationId String    @map("organization_id")
  name           String
  slug           String
  description    String?
  accentColor    String?   @map("accent_color")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       DepartmentMember[]
  cadAgencies   CadAgency[]
  announcements Announcement[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  membershipId String   @map("membership_id")
  title        String?
  isLeader     Boolean  @default(false) @map("is_leader")
  joinedAt     DateTime @default(now()) @map("joined_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([departmentId, membershipId])
  @@index([membershipId])
  @@map("department_members")
}

model PermissionGrant {
  id           String    @id @default(cuid())
  membershipId String    @map("membership_id")
  action       String
  scopeType    String    @default("organization") @map("scope_type")
  scopeId      String?   @map("scope_id")
  reason       String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, action])
  @@map("permission_grants")
}

model PermissionDenial {
  id           String    @id @default(cuid())
  membershipId String    @map("membership_id")
  action       String
  reason       String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, action])
  @@map("permission_denials")
}

model BreakGlassSession {
  id           String   @id @default(cuid())
  membershipId String   @map("membership_id")
  reason       String
  startsAt     DateTime @default(now()) @map("starts_at")
  endsAt       DateTime @map("ends_at")
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, endsAt])
  @@map("break_glass_sessions")
}

// =============================================================================
// Audit (append-only for tenants)
// =============================================================================

model AuditEvent {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  requestId      String?  @map("request_id")
  source         AuditSource
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json     @default("{}")
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

enum AuditSource {
  WEB
  API
  DISCORD
  AUTOMATION
  ERLC
  PLATFORM_SUPPORT
  SYSTEM
  WORKER
}

// =============================================================================
// Integrations & support
// =============================================================================

model IntegrationCredential {
  id             String          @id @default(cuid())
  publicId       String          @unique @map("public_id")
  organizationId String          @map("organization_id")
  provider       String
  label          String?
  ciphertext     String
  iv             String
  authTag        String          @map("auth_tag")
  status         IntegrationStatus @default(DISCONNECTED)
  lastCheckedAt  DateTime?       @map("last_checked_at")
  lastSuccessAt  DateTime?       @map("last_success_at")
  lastError      String?         @map("last_error")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integration_credentials")
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  DEGRADED
  ERROR
}

// Subscription drives the organization's entitlement manifest. Plan features and
// limits live in @commandry/entitlements config; this row holds only the org's
// subscription state + overrides/grants/add-ons (JSON), never scattered plan logic.
model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String    @unique @map("organization_id")
  planKey                String    @default("startup") @map("plan_key")
  status                 String    @default("active")
  provider               String?
  providerSubscriptionId String?   @map("provider_subscription_id")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  trialEndsAt            DateTime? @map("trial_ends_at")
  graceEndsAt            DateTime? @map("grace_ends_at")
  overrides              Json      @default("{}")
  grants                 Json      @default("[]")
  addOns                 Json      @default("[]") @map("add_ons")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Per-organization, per-billing-period usage counters (atomic increments).
model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String
  period         String
  value          Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, period])
  @@index([organizationId])
  @@map("usage_counters")
}

// ER:LC player-history correlation. Rolls up per-player presence in the live
// server and links it to a Roblox identity when one is known for the org.
model ErlcPlayerSession {
  id             String   @id @default(cuid())
  publicId       String   @unique @map("public_id")
  organizationId String   @map("organization_id")
  robloxUserId   String   @map("roblox_user_id")
  robloxUsername String   @map("roblox_username")
  callsign       String?
  team           String?
  lastWantedStars Int?    @map("last_wanted_stars")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  sessionCount   Int      @default(1) @map("session_count")
  totalMinutes   Int      @default(0) @map("total_minutes")
  robloxIdentityId String? @map("roblox_identity_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, robloxUserId])
  @@index([organizationId, lastSeenAt])
  @@map("erlc_player_sessions")
}

// CAD calls: emergency (911) calls, whether synced from ER:LC or dispatcher-created.
model CadCall {
  id              String        @id @default(cuid())
  publicId        String        @unique @map("public_id")
  organizationId  String        @map("organization_id")
  source          String        @default("erlc")
  externalId      String        @map("external_id")
  number          String        @default("911")
  title           String?
  type            String?
  caller          String
  callerId        String?       @map("caller_id")
  message         String
  location        String?
  postal          String?
  street          String?
  priority        Int           @default(3)
  status          CadCallStatus @default(PENDING)
  disposition     String?
  assignedUnit    String?       @map("assigned_unit")
  callNumber      String?       @map("call_number")
  callSequence    Int?          @map("call_sequence")
  agencyId        String?       @map("agency_id")
  createdByUserId String?       @map("created_by_user_id")
  openedAt        DateTime      @default(now()) @map("opened_at")
  dispatchedAt    DateTime?     @map("dispatched_at")
  enRouteAt       DateTime?     @map("en_route_at")
  onSceneAt       DateTime?     @map("on_scene_at")
  clearedAt       DateTime?     @map("cleared_at")
  syncedAt        DateTime      @default(now()) @map("synced_at")
  closedAt        DateTime?     @map("closed_at")
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units        CadCallUnit[]
  logs         CadCallLog[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@map("cad_calls")
}

enum CadCallStatus {
  PENDING
  DISPATCHED
  ACTIVE
  CLOSED
}

// An on-duty unit (officer, EMS, fire, dispatcher) tracked in the CAD.
model CadUnit {
  id             String        @id @default(cuid())
  publicId       String        @unique @map("public_id")
  organizationId String        @map("organization_id")
  callsign       String
  name           String
  type           CadUnitType   @default(POLICE)
  status         CadUnitStatus @default(AVAILABLE)
  userId         String?       @map("user_id")
  membershipId   String?       @map("membership_id")
  agencyId       String?       @map("agency_id")
  division       String?
  locationText   String?       @map("location_text")
  robloxUsername String?       @map("roblox_username")
  onDutyAt       DateTime      @default(now()) @map("on_duty_at")
  lastStatusAt   DateTime      @default(now()) @map("last_status_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agency          CadAgency?    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  callAssignments CadCallUnit[]

  @@unique([organizationId, callsign])
  @@index([organizationId, status])
  @@map("cad_units")
}

enum CadUnitType {
  POLICE
  SHERIFF
  STATE
  FIRE
  EMS
  DISPATCH
}

enum CadUnitStatus {
  AVAILABLE
  BUSY
  EN_ROUTE
  ON_SCENE
  PANIC
  OUT_OF_SERVICE
}

// Assignment of a unit to a call.
model CadCallUnit {
  id         String   @id @default(cuid())
  callId     String   @map("call_id")
  unitId     String   @map("unit_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  call CadCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  unit CadUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([callId, unitId])
  @@index([unitId])
  @@map("cad_call_units")
}

// Timeline note on a call (dispatch narrative).
model CadCallLog {
  id           String   @id @default(cuid())
  callId       String   @map("call_id")
  authorUserId String?  @map("author_user_id")

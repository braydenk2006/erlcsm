// ---------------------------------------------------------------------------
// Scheduled shifts (calendar + claiming + Discord + PRC), built on the shared
// participation ledger and attendance engine. The owner-created scheduled shift
// is the authoritative record; Discord/PRC state and the shift timeline live on
// or alongside it (no duplicate calendar/attendance/Discord models).
// ---------------------------------------------------------------------------

model ScheduledShift {
  id                   String    @id @default(cuid())
  publicId             String    @unique @map("public_id")
  organizationId       String    @map("organization_id")
  title                String
  description          String?
  shiftType            String    @default("patrol") @map("shift_type")
  departmentId         String?   @map("department_id")
  erlcServer           String?   @map("erlc_server")
  timezone             String    @default("UTC")
  scheduledStart       DateTime  @map("scheduled_start")
  scheduledEnd         DateTime  @map("scheduled_end")
  capacity             Int?
  requiredHostCount    Int       @default(1) @map("required_host_count")
  requiredStaffCount   Int       @default(0) @map("required_staff_count")
  minRankOrder         Int?      @map("min_rank_order")
  requiredPermission   String?   @map("required_permission")
  requiredDepartmentId String?   @map("required_department_id")
  claimPolicy          String    @default("FIRST_ELIGIBLE") @map("claim_policy")
  attendancePolicy     String    @default("MANUAL") @map("attendance_policy")
  prcSyncPolicy        String    @default("SUGGEST_ONLY") @map("prc_sync_policy")
  eligibleTeams        String[]  @default([]) @map("eligible_teams")
  status               String    @default("DRAFT")
  hostMembershipId     String?   @map("host_membership_id")
  coHostMembershipIds  String[]  @default([]) @map("co_host_membership_ids")
  claimedAt            DateTime? @map("claimed_at")
  publishedAt          DateTime? @map("published_at")
  actualStart          DateTime? @map("actual_start")
  actualEnd            DateTime? @map("actual_end")
  cancellationReason   String?   @map("cancellation_reason")
  completionNotes      String?   @map("completion_notes")
  recurrenceId         String?   @map("recurrence_id")
  discordChannelId     String?   @map("discord_channel_id")
  discordMessageId     String?   @map("discord_message_id")
  discordEventId       String?   @map("discord_event_id")
  discordState         String    @default("NONE") @map("discord_state")
  prcSyncState         String    @default("IDLE") @map("prc_sync_state")
  lastRemindedOffset   Int?      @map("last_reminded_offset")
  version              Int       @default(0)
  createdByUserId      String    @map("created_by_user_id")
  updatedByUserId      String?   @map("updated_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, scheduledStart])
  @@index([organizationId, status])
  @@index([organizationId, scheduledStart])
  @@map("scheduled_shifts")
}

model ShiftClaim {
  id               String    @id @default(cuid())
